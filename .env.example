# Railway sets PORT automatically. Keep this at 3001 for local development.
PORT=3001
NODE_ENV=development

# Comma-separated web origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# This is intentionally disabled by default. It is only for local/testnet demo wiring
# until wallet-signature authentication is implemented and approved.
ALLOW_UNAUTHENTICATED_WRITES=false

# Enables the bounded Testnet-only demo invoice workflow. Keep false for production data.
DEMO_MODE=false

# deterministic is the safe default. Configure an AI provider only after its key is
# stored in Railway, never in this file or the repository.
UNDERWRITING_PROVIDER=deterministic
AI_API_URL=
AI_API_KEY=
AI_MODEL=
